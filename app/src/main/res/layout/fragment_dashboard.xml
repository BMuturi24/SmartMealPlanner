<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">
    <TextView
        android:id="@+id/welcomeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <TextView
        android:id="@+id/overviewTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Here is an overview of your client's data"
        android:textSize="16sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeTextView"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/clientCountTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Clients\n0"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="#E8EEF7"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/overviewTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/totalBudgetTextView" />

    <TextView
        android:id="@+id/totalBudgetTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Total Budget\nKSh 0"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="#E8EEF7"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/clientCountTextView"
        app:layout_constraintStart_toEndOf="@id/clientCountTextView"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/addClientButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ADD CLIENT"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/clientCountTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button
        android:id="@+id/viewClientButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="VIEW CLIENTS"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/addClientButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>