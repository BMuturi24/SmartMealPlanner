<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="tenant"
            type="com.example.smartmealplanner.Client" />
    </data>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">
            <TextView
                android:id="@+id/newClientLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just added"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <TextView
                android:id="@+id/newClientTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{tenant.summary()}"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="#E8EEF7"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/newClientLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <TextView
                android:id="@+id/allClientsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All tenants"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_goneMarginTop="0dp"
                app:layout_constraintTop_toBottomOf="@id/newClientTextView"
                app:layout_constraintStart_toStartOf="parent" />
            <TextView
                android:id="@+id/allTenantsTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/allClientsLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>