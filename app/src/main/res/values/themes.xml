<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SmartMealPlanner" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#4CAF50</item>          <!-- Main Green -->
        <item name="colorPrimaryVariant">#388E3C</item>   <!-- Darker Green -->
        <item name="colorOnPrimary">#FFFFFF</item>        <!-- Text on Green -->

        <!-- Secondary brand color. -->
        <item name="colorSecondary">#8BC34A</item>        <!-- Light Green / Accent -->
        <item name="colorSecondaryVariant">#689F38</item>
        <item name="colorOnSecondary">#000000</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>
</resources>